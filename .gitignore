# Firebase конфигурация за клиента (Firebase/RTDB + VAPID за push)
# Сложена е в репото, за да не 404-ва на Netlify.

# Локални / временни файлове
.DS_Store
Thumbs.db
*.log
.env
.env.local
node_modules/

# Local Netlify folder
.netlify

# Android signing / build artifacts (не качвай в Git)
android.keystore
keystore.properties
*.aab
*.apk
*.idsig
app/build/
.gradle/
build/
local.properties
google-services.json
.gradle-local/

# iOS signing / Firebase secrets / build artifacts
GoogleService-Info.plist
ios/App/App/GoogleService-Info.plist
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/DerivedData/
*.xcarchive
*.ipa
